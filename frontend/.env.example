# Frontend build-time config (Vite reads VITE_-prefixed vars).
# Copy to .env.local for local overrides, or set these in the Vercel dashboard.

# Backend API origin. Leave blank for local dev (Vite proxies /api) and for a
# same-origin single-service deploy. Set to your Render URL for the Vercel deploy.
VITE_API_BASE=

# Asset/base path. Leave blank ("/app/") when the backend serves the SPA.
# Set to "/" for a standalone deploy at the domain root (Vercel).
VITE_BASE=

# React Router basename. Leave blank ("/app") when backend-served.
# Set to "/" for a standalone Vercel deploy.
VITE_ROUTER_BASE=
