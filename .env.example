# Copy this file to `.env` and fill in the keys you have.
# You only need ONE provider to get started — Gemini is recommended (free tier).

# Google AI Studio — get free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq — get free key at https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — get free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local models via Ollama (offline fallback). Set OLLAMA_MODEL to enable,
# e.g. OLLAMA_MODEL=qwen2.5-coder:7b   OLLAMA_HOST defaults to localhost:11434.
OLLAMA_MODEL=
OLLAMA_HOST=

# Semgrep ruleset for recon (default: auto). Point at a local pack to run offline.
SEMGREP_CONFIG=

# Set to 1 to let the patch verifier install test deps (grants the sandbox network).
PATCH_VERIFY_NETWORK=

# Optional: GitHub token for higher clone rate limits
GITHUB_TOKEN=

# --- Web UI authentication (single-operator password) ---
# Set LOGIN_PASSWORD to require a login before the web API is usable. If left
# blank, the API is UNAUTHENTICATED (fine for localhost-only development).
LOGIN_PASSWORD=
# Display name recorded on attestations / shown in the UI.
OPERATOR_NAME=operator
# Optional fixed signing secret for session cookies. If unset, a random secret
# is generated and persisted to data/.session_secret.
SESSION_SECRET=
# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=0
# Cookie SameSite policy. Use "none" when the frontend is on a different origin
# (e.g. Vercel) than the API (e.g. Render); "none" forces Secure on. Default lax.
COOKIE_SAMESITE=lax
# Comma-separated extra CORS origins for a cross-origin frontend, e.g.
# https://your-app.vercel.app
ALLOWED_ORIGINS=
