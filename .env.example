# Copy this file to `.env` and fill in the keys you have.
# You only need ONE provider to get started — Gemini is recommended (free tier).

# Google AI Studio — get free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq — get free key at https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — get free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local models via Ollama (offline fallback). Set OLLAMA_MODEL to enable,
# e.g. OLLAMA_MODEL=qwen2.5-coder:7b   OLLAMA_HOST defaults to localhost:11434.
OLLAMA_MODEL=
OLLAMA_HOST=

# Semgrep ruleset for recon (default: auto). Point at a local pack to run offline.
SEMGREP_CONFIG=

# Set to 1 to let the patch verifier install test deps (grants the sandbox network).
PATCH_VERIFY_NETWORK=

# Optional: GitHub token for higher clone rate limits
GITHUB_TOKEN=
